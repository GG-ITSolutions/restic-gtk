using Gtk 4.0;
using Adw 1;

template $ResticGtkSnapshotsPage: Adw.NavigationPage {
  tag: "snapshots";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [end]
      Gtk.Button lock_button {
        icon-name: "system-lock-screen-symbolic";
        tooltip-text: _("Lock");
        action-name: "snapshots.lock";
      }

      [end]
      Gtk.Button reload_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Reload");
        action-name: "snapshots.reload";
      }
    }

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "locked";

        child: Adw.StatusPage {
          icon-name: "system-lock-screen-symbolic";
          title: _("Repository Locked");
          description: _("Unlock the repository to browse its snapshots");

          child: Gtk.Button {
            label: _("_Unlock…");
            use-underline: true;
            halign: center;
            action-name: "snapshots.unlock";

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      Gtk.StackPage {
        name: "loading";

        child: Adw.StatusPage loading_status {
          title: _("Loading Snapshots");
          paintable: Adw.SpinnerPaintable {
            widget: loading_status;
          };
        };
      }

      Gtk.StackPage {
        name: "error";

        child: Adw.StatusPage error_status {
          icon-name: "dialog-error-symbolic";
          title: _("Could Not Load Snapshots");

          child: Gtk.Button {
            label: _("_Try Again");
            use-underline: true;
            halign: center;
            action-name: "snapshots.reload";

            styles [
              "pill",
            ]
          };
        };
      }

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "document-open-recent-symbolic";
          title: _("No Snapshots");
          description: _("This repository does not contain any snapshots yet");
        };
      }

      Gtk.StackPage {
        name: "list";

        child: Gtk.ScrolledWindow scrolled_window {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 720;
            tightening-threshold: 560;

            child: Gtk.Box groups_box {
              orientation: vertical;
              spacing: 24;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;
            };
          };
        };
      }
    };
  };
}
