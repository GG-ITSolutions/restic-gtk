using Gtk 4.0;
using Adw 1;

template $ResticGtkRepoInfoDialog: Adw.Dialog {
  title: _("Repository Details");
  content-width: 460;
  content-height: 640;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Stack stack {
      transition-type: crossfade;
      vhomogeneous: false;

      Gtk.StackPage {
        name: "loading";

        child: Adw.StatusPage loading_status {
          title: _("Reading Repository");
          description: _("All repository files are listed and the index is read, which can take a while for large repositories");
          paintable: Adw.SpinnerPaintable {
            widget: loading_status;
          };

          styles [
            "compact",
          ]
        };
      }

      Gtk.StackPage {
        name: "error";

        child: Adw.StatusPage error_status {
          icon-name: "dialog-error-symbolic";
          title: _("Could Not Read Repository");

          styles [
            "compact",
          ]
        };
      }

      Gtk.StackPage {
        name: "stats";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            Adw.ActionRow location_row {
              title: _("Location");
              subtitle-selectable: true;

              styles [
                "property",
              ]
            }

            Adw.ActionRow id_row {
              title: _("Repository ID");
              subtitle-selectable: true;

              styles [
                "property",
                "monospace",
              ]
            }

            Adw.ActionRow version_row {
              title: _("Format");

              styles [
                "property",
              ]
            }

            Adw.ActionRow snapshots_row {
              title: _("Snapshots");

              styles [
                "property",
              ]
            }
          }

          Adw.PreferencesGroup {
            title: _("Storage");

            Adw.ActionRow stored_row {
              title: _("Size on Storage");

              styles [
                "property",
              ]
            }

            Adw.ActionRow raw_row {
              title: _("Unique Data");
              tooltip-text: _("File contents and folder listings after deduplication, uncompressed");

              styles [
                "property",
              ]
            }

            Adw.ActionRow compression_row {
              title: _("Compression");

              styles [
                "property",
              ]
            }

            Adw.ActionRow packs_row {
              title: _("Pack Files");

              styles [
                "property",
              ]
            }
          }
        };
      }
    };
  };
}
