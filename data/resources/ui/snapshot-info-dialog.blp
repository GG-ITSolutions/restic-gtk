using Gtk 4.0;
using Adw 1;

template $ResticGtkSnapshotInfoDialog: Adw.Dialog {
  title: _("Snapshot Details");
  content-width: 460;
  content-height: 640;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.ActionRow time_row {
          title: _("Time");

          styles [
            "property",
          ]
        }

        Adw.ActionRow host_row {
          title: _("Host");

          styles [
            "property",
          ]
        }

        Adw.ActionRow paths_row {
          title: _("Paths");
          subtitle-selectable: true;

          styles [
            "property",
          ]
        }

        Adw.ActionRow tags_row {
          title: _("Tags");

          styles [
            "property",
          ]
        }

        Adw.ActionRow id_row {
          title: _("ID");
          subtitle-selectable: true;

          styles [
            "property",
            "monospace",
          ]
        }

        Adw.ActionRow program_row {
          title: _("Created By");

          styles [
            "property",
          ]
        }
      }

      Adw.PreferencesGroup backup_group {
        title: _("Backup");

        Adw.ActionRow size_row {
          title: _("Size");

          styles [
            "property",
          ]
        }

        Adw.ActionRow files_row {
          title: _("Files");

          styles [
            "property",
          ]
        }

        Adw.ActionRow dirs_row {
          title: _("Folders");

          styles [
            "property",
          ]
        }

        Adw.ActionRow added_row {
          title: _("Added to Repository");

          styles [
            "property",
          ]
        }

        Adw.ActionRow duration_row {
          title: _("Duration");

          styles [
            "property",
          ]
        }
      }
    };
  };
}
